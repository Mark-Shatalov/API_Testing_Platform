+package dev.apitestingplatform.app;
+
+import dev.apitestingplatform.persistence.sqlite.DataDirectory;
+import javafx.application.Application;
+
+import java.nio.file.Path;
+import java.util.Arrays;
+
+/**
+ * Entry point used by the installed launchers and {@code javafx:run}.
+ * It runs before any JavaFX, JNA or SQLite native library is loaded, so their extraction caches can be
+ * redirected from the user profile root and the system temporary folder into the per-user data directory.
+ */
+public final class Main {
+    private Main() { }
+
+    public static void main(String[] args) {
+        if (Arrays.asList(args).contains(UserDataRemoval.ARGUMENT)) {
+            // Removal must not load native caches from the directory it is about to delete.
+            RuntimeLocations.configureTemporary(Path.of(System.getProperty("java.io.tmpdir")));
+            Application.launch(UserDataRemovalApplication.class);
+            return;
+        }
+        Path data = null;
+        try { data = DataDirectory.database().getParent(); }
+        catch (IllegalStateException unavailable) { /* The application reports missing LOCALAPPDATA during startup. */ }
+        if (data != null) RuntimeLocations.configure(data, RuntimeLocations.applicationVersion());
+        Application.launch(ApiTestingPlatformApplication.class, args);
+    }
+}
diff --git a/app/src/main/java/dev/apitestingplatform/app/RuntimeLocations.java b/app/src/main/java/dev/apitestingplatform/app/RuntimeLocations.java
new file mode 100644
index 0000000..e2bfa5d
--- /dev/null
+++ b/app/src/main/java/dev/apitestingplatform/app/RuntimeLocations.java
@@ -0,0 +1,73 @@
+package dev.apitestingplatform.app;
+
+import java.io.IOException;
+import java.io.UncheckedIOException;
+import java.nio.file.*;
+import java.util.Comparator;
+import java.util.Map;
+import java.util.regex.Pattern;
+import java.util.stream.Stream;
+
+/**
+ * Native-library extraction caches. JavaFX would otherwise use {@code %USERPROFILE%\.openjfx}, while JNA and
+ * SQLite use the system temporary folder. Installed builds keep them below
+ * {@code %LOCALAPPDATA%\API Testing Platform\cache\<version>}, never in the installation directory.
+ */
+final class RuntimeLocations {
+    static final String CACHE = "cache";
+    private static final Pattern SAFE_VERSION = Pattern.compile("[0-9A-Za-z][0-9A-Za-z._-]{0,63}");
+    private static final Map<String, String> PROPERTIES = Map.of(
+            "javafx.cachedir", "openjfx",
+            "jna.tmpdir", "jna",
+            "org.sqlite.tmpdir", "sqlite");
+
+    private RuntimeLocations() { }
+
+    /** jpackage writes {@code jpackage.app-version}; development runs share one "dev" cache. */
+    static String applicationVersion() {
+        String version = System.getProperty("jpackage.app-version", "dev");
+        return SAFE_VERSION.matcher(version).matches() ? version : "dev";
+    }
+
+    static Path cacheRoot(Path dataDirectory, String version) {
+        return dataDirectory.resolve(CACHE).resolve(version);
+    }
+
+    /** Sets only properties the user has not overridden, creates the folders and removes caches of older versions. */
+    static void configure(Path dataDirectory, String version) {
+        Path root = cacheRoot(dataDirectory, version);
+        assign(root);
+        removeOtherVersions(dataDirectory.resolve(CACHE), version);
+    }
+
+    static void configureTemporary(Path temporaryDirectory) {
+        assign(temporaryDirectory.resolve("api-testing-platform-maintenance"));
+    }
+
+    private static void assign(Path root) {
+        PROPERTIES.forEach((property, folder) -> {
+            if (System.getProperty(property) != null) return;
+            Path target = root.resolve(folder);
+            try { Files.createDirectories(target); System.setProperty(property, target.toString()); }
+            catch (IOException | SecurityException unavailable) { /* Library defaults remain usable. */ }
+        });
+    }
+
+    /** Best effort: a library still loaded by another running version stays locked and is skipped. */
+    static void removeOtherVersions(Path caches, String current) {
+        if (!Files.isDirectory(caches, LinkOption.NOFOLLOW_LINKS)) return;
+        try (Stream<Path> versions = Files.list(caches)) {
+            versions.filter(path -> !path.getFileName().toString().equals(current))
+                    .filter(path -> Files.isDirectory(path, LinkOption.NOFOLLOW_LINKS))
+                    .forEach(RuntimeLocations::deleteQuietly);
+        } catch (IOException ignored) { /* Cache cleanup never blocks startup. */ }
+    }
+
+    private static void deleteQuietly(Path directory) {
+        try (Stream<Path> tree = Files.walk(directory)) {
+            tree.sorted(Comparator.reverseOrder()).forEach(path -> {
+                try { Files.deleteIfExists(path); } catch (IOException ignored) { }
+            });
+        } catch (IOException | UncheckedIOException ignored) { }
+    }
+}
diff --git a/app/src/main/java/dev/apitestingplatform/app/UserDataRemoval.java b/app/src/main/java/dev/apitestingplatform/app/UserDataRemoval.java
new file mode 100644
index 0000000..379a196
--- /dev/null
+++ b/app/src/main/java/dev/apitestingplatform/app/UserDataRemoval.java
@@ -0,0 +1,87 @@
+package dev.apitestingplatform.app;
+
+import java.io.IOException;
+import java.nio.channels.FileChannel;
+import java.nio.channels.FileLock;
+import java.nio.channels.OverlappingFileLockException;
+import java.nio.file.*;
+import java.nio.file.attribute.BasicFileAttributes;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.stream.Stream;
+
+/**
+ * Explicit, user-requested removal of this Windows user's local data. Uninstalling never calls this:
+ * the installer leaves {@code %LOCALAPPDATA%\API Testing Platform} untouched unless the user runs the
+ * separate "Remove API Testing Platform Data" shortcut and confirms.
+ */
+final class UserDataRemoval {
+    static final String ARGUMENT = "--remove-user-data";
+    static final String FOLDER = "API Testing Platform";
+    private static final String LOCK = "platform.sqlite.lock";
+
+    enum Outcome { REMOVED, NOTHING_TO_REMOVE, IN_USE, REFUSED, INCOMPLETE }
+    record Result(Outcome outcome, Path directory, int remainingEntries) { }
+
+    private UserDataRemoval() { }
+
+    /**
+     * Deletes {@code localAppData\API Testing Platform} completely. Refuses any other location, refuses while
+     * the application holds its single-instance lock, and never follows links or junctions out of the folder.
+     */
+    static Result remove(Path localAppData, Path dataDirectory) {
+        Path base = localAppData.toAbsolutePath().normalize();
+        Path directory = dataDirectory.toAbsolutePath().normalize();
+        if (directory.getParent() == null || !directory.getParent().equals(base) || !directory.getFileName().toString().equals(FOLDER))
+            return new Result(Outcome.REFUSED, directory, 0);
+        if (!Files.exists(directory, LinkOption.NOFOLLOW_LINKS)) return new Result(Outcome.NOTHING_TO_REMOVE, directory, 0);
+        BasicFileAttributes root;
+        try { root = Files.readAttributes(directory, BasicFileAttributes.class, LinkOption.NOFOLLOW_LINKS); }
+        catch (IOException unreadable) { return new Result(Outcome.INCOMPLETE, directory, 1); }
+        if (!isPlainDirectory(root)) return new Result(Outcome.REFUSED, directory, 0);
+
+        Path lockPath = directory.resolve(LOCK);
+        List<Path> failures = new ArrayList<>();
+        try (FileChannel channel = FileChannel.open(lockPath, StandardOpenOption.CREATE, StandardOpenOption.WRITE)) {
+            final FileLock lock = tryLock(channel);
+            if (lock == null) return new Result(Outcome.IN_USE, directory, 0);
+            try (lock) { deleteChildren(directory, lockPath, failures); }
+        } catch (IOException lockUnavailable) {
+            return new Result(Outcome.IN_USE, directory, 0);
+        }
+        deleteEntry(lockPath, failures);
+        if (failures.isEmpty()) deleteEntry(directory, failures);
+        return failures.isEmpty() ? new Result(Outcome.REMOVED, directory, 0) : new Result(Outcome.INCOMPLETE, directory, failures.size());
+    }
+
+    private static FileLock tryLock(FileChannel channel) throws IOException {
+        try { return channel.tryLock(); } catch (OverlappingFileLockException sameProcess) { return null; }
+    }
+
+    private static void deleteChildren(Path directory, Path keep, List<Path> failures) {
+        try (Stream<Path> children = Files.list(directory)) {
+            for (Path child : children.toList()) {
+                if (child.equals(keep)) continue;
+                deleteTree(child, failures);
+            }
+        } catch (IOException unreadable) { failures.add(directory); }
+    }
+
+    private static void deleteTree(Path path, List<Path> failures) {
+        try {
+            BasicFileAttributes attributes = Files.readAttributes(path, BasicFileAttributes.class, LinkOption.NOFOLLOW_LINKS);
+            // A link or NTFS junction is removed itself; its target outside the data folder is never visited.
+            if (isPlainDirectory(attributes)) deleteChildren(path, null, failures);
+        } catch (IOException unreadable) { failures.add(path); return; }
+        deleteEntry(path, failures);
+    }
+
+    private static void deleteEntry(Path path, List<Path> failures) {
+        try { Files.deleteIfExists(path); } catch (IOException locked) { failures.add(path); }
+    }
+
+    /** On Windows a junction reports {@code isDirectory() && isOther()}; only ordinary folders are descended. */
+    private static boolean isPlainDirectory(BasicFileAttributes attributes) {
+        return attributes.isDirectory() && !attributes.isSymbolicLink() && !attributes.isOther();
+    }
+}
diff --git a/app/src/main/java/dev/apitestingplatform/app/UserDataRemovalApplication.java b/app/src/main/java/dev/apitestingplatform/app/UserDataRemovalApplication.java
new file mode 100644
index 0000000..7f11ac2
--- /dev/null
+++ b/app/src/main/java/dev/apitestingplatform/app/UserDataRemovalApplication.java
@@ -0,0 +1,71 @@
+package dev.apitestingplatform.app;
+
+import dev.apitestingplatform.persistence.sqlite.DataDirectory;
+import javafx.application.Application;
+import javafx.application.Platform;
+import javafx.scene.control.Alert;
+import javafx.scene.control.ButtonBar;
+import javafx.scene.control.ButtonType;
+import javafx.scene.control.Label;
+import javafx.stage.Stage;
+
+import java.nio.file.Path;
+
+/** Confirmation window for the "Remove API Testing Platform Data" Start menu shortcut. */
+public final class UserDataRemovalApplication extends Application {
+    static final String TITLE = "Remove API Testing Platform Data";
+    private static final ButtonType REMOVE = new ButtonType("Remove data", ButtonBar.ButtonData.OK_DONE);
+
+    @Override public void start(Stage ignored) {
+        // The confirmation closes before the background removal reports back; exit explicitly instead.
+        Platform.setImplicitExit(false);
+        String local = System.getenv("LOCALAPPDATA");
+        if (local == null || local.isBlank()) { finish(Alert.AlertType.ERROR, "LOCALAPPDATA is unavailable, so no data was removed."); return; }
+        Path data;
+        try { data = DataDirectory.database().getParent(); }
+        catch (IllegalStateException unavailable) { finish(Alert.AlertType.ERROR, "The data folder could not be located, so no data was removed."); return; }
+
+        Alert confirm = new Alert(Alert.AlertType.CONFIRMATION, "", REMOVE, ButtonType.CANCEL);
+        confirm.setTitle(TITLE);
+        confirm.setHeaderText("Permanently remove your local API Testing Platform data?");
+        Label details = new Label(description(data));
+        details.setWrapText(true); details.setMaxWidth(520);
+        confirm.getDialogPane().setContent(details);
+        // Cancel is the default: pressing Enter must never delete data.
+        ((javafx.scene.control.Button) confirm.getDialogPane().lookupButton(REMOVE)).setDefaultButton(false);
+        ((javafx.scene.control.Button) confirm.getDialogPane().lookupButton(ButtonType.CANCEL)).setDefaultButton(true);
+        if (confirm.showAndWait().filter(REMOVE::equals).isEmpty()) { Platform.exit(); return; }
+
+        Thread.ofPlatform().daemon().name("user-data-removal").start(() -> {
+            UserDataRemoval.Result result = UserDataRemoval.remove(Path.of(local), data);
+            Platform.runLater(() -> finish(result.outcome() == UserDataRemoval.Outcome.REMOVED || result.outcome() == UserDataRemoval.Outcome.NOTHING_TO_REMOVE
+                    ? Alert.AlertType.INFORMATION : Alert.AlertType.WARNING, message(result)));
+        });
+    }
+
+    static String description(Path data) {
+        return "This deletes " + data + " for the current Windows user, including saved workspaces, collections, requests, "
+                + "environments, encrypted secrets, history, recovery drafts, automatic backups, logs, settings and caches.\n\n"
+                + "It cannot be undone. Use Workspace → Export workspace first if you need a portable copy. Files you exported "
+                + "or backed up to other folders are not touched. The application stays installed; uninstall it separately from "
+                + "Windows Settings → Apps.";
+    }
+
+    static String message(UserDataRemoval.Result result) {
+        return switch (result.outcome()) {
+            case REMOVED -> "Local data was removed from " + result.directory() + ".";
+            case NOTHING_TO_REMOVE -> "There is no local data at " + result.directory() + ".";
+            case IN_USE -> "API Testing Platform is running. Close it, then run this shortcut again. Nothing was removed.";
+            case REFUSED -> "The data folder location was not recognised, so nothing was removed.";
+            case INCOMPLETE -> result.remainingEntries() + " item(s) could not be removed, usually because another program has them open. "
+                    + "Close it and run this shortcut again, or delete " + result.directory() + " in File Explorer.";
+        };
+    }
+
+    private static void finish(Alert.AlertType type, String text) {
+        Alert alert = new Alert(type, text, ButtonType.OK);
+        alert.setTitle(TITLE); alert.setHeaderText(null);
+        alert.showAndWait();
+        Platform.exit();
+    }
+}
