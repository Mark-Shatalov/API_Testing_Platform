diff --git a/packaging/windows/Build-Installer.ps1 b/packaging/windows/Build-Installer.ps1
new file mode 100644
index 0000000..dc5b6f2
--- /dev/null
+++ b/packaging/windows/Build-Installer.ps1
@@ -0,0 +1,184 @@
+<#
+.SYNOPSIS
+    Builds the Windows installer for API Testing Platform with a bundled Java runtime.
+
+.DESCRIPTION
+    1. Checks Windows x64, JDK 25 (java, jlink, jpackage, jdeps) and WiX Toolset.
+    2. Runs the Maven Wrapper build (clean verify), which also copies the runtime module path
+       to packaging\target\jpackage\modules.
+    3. Links a minimal Java runtime with jlink (JDK modules only).
+    4. Creates an app image with jpackage and smoke-tests it with temporary user data.
+    5. Creates the MSI (or EXE) with jpackage, plus SHA-256 checksums and build information in dist\.
+
+    Users of the installer need no JDK, JRE, server or service.
+
+.EXAMPLE
+    .\packaging\windows\Build-Installer.ps1
+.EXAMPLE
+    .\packaging\windows\Build-Installer.ps1 -AppVersion 0.1.1 -SkipTests
+#>
+[CmdletBinding()]
+param(
+    [ValidateSet('msi', 'exe')][string]$Type = 'msi',
+    # Defaults to the Maven project version without -SNAPSHOT.
+    [string]$AppVersion,
+    [string]$Destination,
+    [string]$JavaHome = $env:JAVA_HOME,
+    [switch]$SkipTests,
+    # Reuse an existing packaging\target\jpackage\modules from a previous Maven build.
+    [switch]$SkipMavenBuild,
+    [switch]$Offline,
+    # Stop after the tested app image; no WiX Toolset is required.
+    [switch]$AppImageOnly,
+    [switch]$SkipSmokeTest
+)
+$ErrorActionPreference = 'Stop'
+. (Join-Path $PSScriptRoot 'Common.ps1')
+
+Assert-WindowsX64
+$root = Get-RepositoryRoot
+$settings = Get-InstallerSettings $root
+if ([string]::IsNullOrWhiteSpace($AppVersion)) { $AppVersion = $settings.ProjectVersion }
+$AppVersion = ConvertTo-InstallerVersion $AppVersion
+if ([string]::IsNullOrWhiteSpace($Destination)) { $Destination = Join-Path $root 'dist' }
+$jdk = Get-Jdk $JavaHome
+$env:JAVA_HOME = $jdk.Home
+$wix = 'not used (app image only)'
+if (-not $AppImageOnly) { $wix = Get-WixToolset }
+Write-Host "Packaging $($settings.Name) $AppVersion with $($jdk.Vendor) $($jdk.Version) and $wix"
+
+# --- Maven Wrapper build ---------------------------------------------------------------------------
+if (-not $SkipMavenBuild) {
+    $maven = @('-B', '--no-transfer-progress')
+    if ($Offline) { $maven += '--offline' }
+    if ($SkipTests) { $maven += '-DskipTests' }
+    $maven += @('clean', 'verify')
+    Push-Location $root
+    try { Invoke-Checked (Join-Path $root 'mvnw.cmd') $maven 'Maven Wrapper build (mvnw.cmd clean verify)' }
+    finally { Pop-Location }
+}
+
+$work = Join-Path $root 'packaging\target\jpackage'
+$copied = Join-Path $work 'modules'
+if (-not (Test-Path -LiteralPath $copied)) { throw "$copied does not exist. Run without -SkipMavenBuild." }
+
+# Copy the module path, dropping JavaFX's empty platform-independent jars (the -win jars hold the code).
+$modulePath = New-EmptyDirectory (Join-Path $work 'mods')
+$jars = @(Get-ChildItem -LiteralPath $copied -Filter '*.jar' | Where-Object { $_.Name -notmatch '^javafx-[a-z]+-[0-9.]+\.jar$' })
+foreach ($jar in $jars) { Copy-Item -LiteralPath $jar.FullName -Destination $modulePath }
+if (-not ($jars | Where-Object { $_.Name -match '^app-.+\.jar$' })) { throw 'The app module jar is missing from the copied module path.' }
+if (-not ($jars | Where-Object { $_.Name -match '^javafx-graphics-.+-win\.jar$' })) {
+    throw 'The Windows JavaFX jars are missing. Build on Windows so Maven selects the "win" JavaFX classifier.'
+}
+
+# --- Bundled Java runtime --------------------------------------------------------------------------
+$listed = @(Get-Content -LiteralPath (Join-Path $PSScriptRoot 'runtime-modules.txt') |
+        ForEach-Object { $_.Trim() } | Where-Object { $_ -and -not $_.StartsWith('#') })
+$detected = @()
+$jarPaths = @($jars | ForEach-Object { Join-Path $modulePath $_.Name })
+$jdeps = Invoke-Captured $jdk.Jdeps (@('--multi-release', '25', '--ignore-missing-deps', '--print-module-deps',
+        '--class-path', ($jarPaths -join ';')) + $jarPaths)
+$printed = $jdeps.Output | Where-Object { $_ -match '^[a-z][a-z0-9_.]*(,[a-z][a-z0-9_.]*)*$' } | Select-Object -Last 1
+if ($jdeps.ExitCode -eq 0 -and $printed) { $detected = @($printed -split ',') }
+else { Write-Warning "jdeps could not analyse the module path; using runtime-modules.txt only.`n$($jdeps.Output -join "`n")" }
+$missing = @($detected | Where-Object { $listed -notcontains $_ })
+if ($missing.Count -gt 0) { Write-Warning "jdeps found JDK modules not listed in runtime-modules.txt; adding them: $($missing -join ', ')" }
+$runtimeModules = @($listed + $missing | Sort-Object -Unique)
+
+$runtime = Join-Path $work 'runtime'
+if (Test-Path -LiteralPath $runtime) { Remove-Item -LiteralPath $runtime -Recurse -Force }
+Invoke-Checked $jdk.Jlink @('--add-modules', ($runtimeModules -join ','), '--strip-debug', '--no-header-files',
+    '--no-man-pages', '--strip-native-commands', '--compress', 'zip-6', '--output', $runtime) 'jlink (bundled Java runtime)'
+
+# --- jpackage ----------------------------------------------------------------------------------------
+$icon = Join-Path $PSScriptRoot 'app.ico'
+$removeProperties = Join-Path $work 'remove-user-data.properties'
+# Properties files treat backslashes as escapes; forward slashes are valid Windows paths.
+@(
+    'arguments=--remove-user-data'
+    "description=Permanently removes this Windows user's $($settings.Name) data after confirmation"
+    "icon=$($icon.Replace('\', '/'))"
+    'win-menu=true'
+    'win-shortcut=false'
+) | Set-Content -LiteralPath $removeProperties -Encoding ASCII
+
+$common = @(
+    '--name', $settings.Name,
+    '--app-version', $AppVersion,
+    '--vendor', $settings.Vendor,
+    '--description', $settings.Description,
+    '--copyright', $settings.Copyright,
+    '--icon', $icon,
+    '--runtime-image', $runtime,
+    '--module-path', $modulePath,
+    '--module', $settings.MainModule,
+    '--java-options', $settings.JavaOptions,
+    '--add-launcher', "$($settings.RemoveLauncher)=$removeProperties"
+)
+
+$images = New-EmptyDirectory (Join-Path $work 'image')
+Invoke-Checked $jdk.Jpackage (@('--type', 'app-image', '--dest', $images) + $common) 'jpackage app image'
+$image = Join-Path $images $settings.Name
+$launcher = Join-Path $image "$($settings.Name).exe"
+foreach ($required in $launcher, (Join-Path $image "$($settings.RemoveLauncher).exe"), (Join-Path $image 'runtime\release')) {
+    if (-not (Test-Path -LiteralPath $required)) { throw "The app image is incomplete: $required is missing." }
+}
+$smoke = $null
+if (-not $SkipSmokeTest) {
+    $smoke = & (Join-Path $PSScriptRoot 'Test-AppImage.ps1') -Launcher $launcher -ExpectedVersion $AppVersion
+}
+if ($AppImageOnly) {
+    Write-Host "App image ready: $image" -ForegroundColor Green
+    return
+}
+
+New-Item -ItemType Directory -Path $Destination -Force | Out-Null
+$installer = Join-Path $Destination "$($settings.Name)-$AppVersion.$Type"
+if (Test-Path -LiteralPath $installer) { Remove-Item -LiteralPath $installer -Force }
+# Per-machine install into Program Files: user data in %LOCALAPPDATA% stays separate from the install
+# directory (a per-user jpackage install would use %LOCALAPPDATA%\<name> itself).
+Invoke-Checked $jdk.Jpackage (@('--type', $Type, '--dest', $Destination) + $common + @(
+        '--win-upgrade-uuid', $settings.UpgradeUuid,
+        '--win-menu', '--win-menu-group', $settings.Name,
+        '--win-shortcut', '--win-shortcut-prompt',
+        '--win-dir-chooser')) "jpackage $Type installer"
+if (-not (Test-Path -LiteralPath $installer)) { throw "jpackage did not create $installer." }
+
+# --- Checksums and build record ----------------------------------------------------------------------
+$hash = Get-FileSha256 $installer
+$fileName = Split-Path -Leaf $installer
+$sums = Join-Path $Destination 'SHA256SUMS.txt'
+$lines = @()
+if (Test-Path -LiteralPath $sums) { $lines = @(Get-Content -LiteralPath $sums | Where-Object { $_ -notmatch "\*$([regex]::Escape($fileName))$" }) }
+@($lines + "$hash *$fileName") | Set-Content -LiteralPath $sums -Encoding ASCII
+
+$commit = 'unknown'; $dirty = $null
+if (Get-Command 'git.exe' -ErrorAction SilentlyContinue) {
+    $head = Invoke-Captured 'git.exe' @('-C', $root, 'rev-parse', 'HEAD')
+    if ($head.ExitCode -eq 0) {
+        $commit = $head.Output[0]
+        $dirty = ((Invoke-Captured 'git.exe' @('-C', $root, 'status', '--porcelain')).Output.Count -gt 0)
+    }
+}
+$jars = @($jars | Sort-Object Name | ForEach-Object { [ordered]@{ file = $_.Name; sha256 = Get-FileSha256 $_.FullName } })
+[ordered]@{
+    application     = $settings.Name
+    version         = $AppVersion
+    projectVersion  = $settings.ProjectVersion
+    installer       = $fileName
+    sha256          = $hash
+    upgradeUuid     = $settings.UpgradeUuid
+    gitCommit       = $commit
+    gitDirty        = $dirty
+    builtAtUtc      = (Get-Date).ToUniversalTime().ToString('yyyy-MM-ddTHH:mm:ssZ')
+    jdk             = "$($jdk.Vendor) $($jdk.Version)"
+    wix             = $wix
+    testsSkipped    = [bool]$SkipTests
+    runtimeModules  = $runtimeModules
+    jdepsDetected   = $detected
+    smokeTest       = $smoke
+    modulePath      = $jars
+} | ConvertTo-Json -Depth 5 | Set-Content -LiteralPath (Join-Path $Destination "$($settings.Name)-$AppVersion.build-info.json") -Encoding UTF8
+
+Write-Host "Installer: $installer" -ForegroundColor Green
+Write-Host "SHA-256:   $hash"
diff --git a/packaging/windows/Common.ps1 b/packaging/windows/Common.ps1
new file mode 100644
index 0000000..3232b86
--- /dev/null
+++ b/packaging/windows/Common.ps1
@@ -0,0 +1,133 @@
+# Shared helpers for the Windows packaging scripts. Compatible with Windows PowerShell 5.1 and PowerShell 7.
+Set-StrictMode -Version 3.0
+
+function Get-RepositoryRoot {
+    return (Resolve-Path -LiteralPath (Join-Path $PSScriptRoot '..\..')).Path
+}
+
+function Assert-WindowsX64 {
+    if ($env:OS -ne 'Windows_NT') { throw 'Windows packaging must run on Windows 10 or Windows 11.' }
+    if (-not [Environment]::Is64BitOperatingSystem) { throw 'A 64-bit Windows installation is required.' }
+}
+
+function Get-XmlText([System.Xml.XmlElement]$Parent, [string]$Name) {
+    $node = $Parent.SelectSingleNode("*[local-name()='$Name']")
+    if ($null -eq $node -or [string]::IsNullOrWhiteSpace($node.InnerText)) { throw "pom.xml is missing <$Name>." }
+    return $node.InnerText.Trim()
+}
+
+# packaging/pom.xml is the single source of installer metadata.
+function Get-InstallerSettings([string]$Root) {
+    [xml]$packaging = Get-Content -LiteralPath (Join-Path $Root 'packaging\pom.xml') -Raw
+    [xml]$parent = Get-Content -LiteralPath (Join-Path $Root 'pom.xml') -Raw
+    $properties = $packaging.DocumentElement.SelectSingleNode("*[local-name()='properties']")
+    return [pscustomobject]@{
+        Name           = Get-XmlText $properties 'installer.name'
+        Vendor         = Get-XmlText $properties 'installer.vendor'
+        Description    = Get-XmlText $properties 'installer.description'
+        Copyright      = Get-XmlText $properties 'installer.copyright'
+        UpgradeUuid    = Get-XmlText $properties 'installer.upgradeUuid'
+        MainModule     = Get-XmlText $properties 'installer.mainModule'
+        JavaOptions    = Get-XmlText $properties 'installer.javaOptions'
+        ProjectVersion = Get-XmlText $parent.DocumentElement 'version'
+        RemoveLauncher = 'Remove API Testing Platform Data'
+    }
+}
+
+# Windows Installer compares major.minor.build only, with limits 255.255.65535.
+function ConvertTo-InstallerVersion([string]$Version) {
+    $candidate = $Version -replace '-SNAPSHOT$', ''
+    if ($candidate -notmatch '^(\d+)\.(\d+)\.(\d+)$') {
+        throw "Installer version '$Version' must look like MAJOR.MINOR.PATCH (an optional -SNAPSHOT suffix is removed)."
+    }
+    if ([int]$Matches[1] -gt 255 -or [int]$Matches[2] -gt 255 -or [int]$Matches[3] -gt 65535) {
+        throw "Installer version '$candidate' exceeds the Windows Installer limit 255.255.65535."
+    }
+    return $candidate
+}
+
+function Invoke-Checked([string]$FilePath, [string[]]$Arguments, [string]$Activity) {
+    Write-Host "> $Activity" -ForegroundColor Cyan
+    & $FilePath @Arguments
+    if ($LASTEXITCODE -ne 0) { throw "$Activity failed with exit code $LASTEXITCODE." }
+}
+
+# Captures stdout and stderr as text. Windows PowerShell 5.1 would otherwise turn redirected stderr into errors.
+function Invoke-Captured([string]$FilePath, [string[]]$Arguments) {
+    $previous = $ErrorActionPreference
+    $ErrorActionPreference = 'Continue'
+    try {
+        $output = @(& $FilePath @Arguments 2>&1 | ForEach-Object { "$_" })
+        $code = $LASTEXITCODE
+    } finally { $ErrorActionPreference = $previous }
+    return [pscustomobject]@{ ExitCode = $code; Output = $output }
+}
+
+function Get-Jdk([string]$JavaHome) {
+    if ([string]::IsNullOrWhiteSpace($JavaHome)) {
+        throw 'Set JAVA_HOME (or pass -JavaHome) to a JDK 25 installation, for example C:\Program Files\Eclipse Adoptium\jdk-25.0.4.101-hotspot.'
+    }
+    $tools = [ordered]@{}
+    foreach ($tool in 'java', 'jlink', 'jpackage', 'jdeps') {
+        $path = Join-Path $JavaHome "bin\$tool.exe"
+        if (-not (Test-Path -LiteralPath $path)) { throw "$path is missing. JAVA_HOME must point to a full JDK 25, not a JRE." }
+        $tools[$tool] = $path
+    }
+    $settings = Invoke-Captured $tools.java @('-XshowSettings:properties', '-version')
+    $read = {
+        param($key)
+        $line = $settings.Output | Where-Object { $_ -match "^\s*$([regex]::Escape($key)) = " } | Select-Object -First 1
+        if ($null -eq $line) { return '' }
+        return ($line -replace "^\s*$([regex]::Escape($key)) = ", '').Trim()
+    }
+    $specification = & $read 'java.specification.version'
+    if ($specification -ne '25') { throw "JDK 25 is required; $JavaHome reports Java '$specification'." }
+    return [pscustomobject]@{
+        Home     = $JavaHome
+        Version  = & $read 'java.runtime.version'
+        Vendor   = & $read 'java.vendor'
+        Java     = $tools.java
+        Jlink    = $tools.jlink
+        Jpackage = $tools.jpackage
+        Jdeps    = $tools.jdeps
+    }
+}
+
+# jpackage 25 supports WiX Toolset v3 (candle/light) and v4/v5 (wix.exe with the Util and UI extensions).
+function Get-WixToolset {
+    $dotnetTools = Join-Path $env:USERPROFILE '.dotnet\tools'
+    if ((Test-Path -LiteralPath (Join-Path $dotnetTools 'wix.exe')) -and (($env:PATH -split ';') -notcontains $dotnetTools)) {
+        $env:PATH = "$dotnetTools;$env:PATH"
+    }
+    $wix = Get-Command 'wix.exe' -ErrorAction SilentlyContinue
+    if ($null -ne $wix) {
+        $version = ((Invoke-Captured $wix.Source @('--version')).Output | Select-Object -First 1) -replace '\+.*$', ''
+        $major = 0
+        [void][int]::TryParse(($version -split '\.')[0], [ref]$major)
+        if ($major -ge 6) { Write-Warning "WiX $version is newer than the WiX 5 release this build is validated with." }
+        if ($major -ge 4) {
+            $extensions = (Invoke-Captured $wix.Source @('extension', 'list', '-g')).Output -join "`n"
+            foreach ($extension in 'WixToolset.Util.wixext', 'WixToolset.UI.wixext') {
+                if ($extensions -notmatch [regex]::Escape($extension)) {
+                    throw "WiX $version is missing the global $extension extension. Run packaging\windows\Install-WixToolset.ps1."
+                }
+            }
+            return "WiX $version"
+        }
+    }
+    $candle = Get-Command 'candle.exe' -ErrorAction SilentlyContinue
+    $light = Get-Command 'light.exe' -ErrorAction SilentlyContinue
+    if ($null -ne $candle -and $null -ne $light) {
+        return "WiX $((Get-Item -LiteralPath $candle.Source).VersionInfo.ProductVersion)"
+    }
+    throw 'WiX Toolset was not found. Run packaging\windows\Install-WixToolset.ps1 (installs WiX 5.0.2 as a .NET tool), then open a new PowerShell window.'
+}
+
+function Get-FileSha256([string]$Path) {
+    return (Get-FileHash -Algorithm SHA256 -LiteralPath $Path).Hash.ToLowerInvariant()
+}
+
+function New-EmptyDirectory([string]$Path) {
+    if (Test-Path -LiteralPath $Path) { Remove-Item -LiteralPath $Path -Recurse -Force }
+    return (New-Item -ItemType Directory -Path $Path -Force).FullName
+}
diff --git a/packaging/windows/Install-WixToolset.ps1 b/packaging/windows/Install-WixToolset.ps1
new file mode 100644
index 0000000..6b078b0
--- /dev/null
+++ b/packaging/windows/Install-WixToolset.ps1
@@ -0,0 +1,27 @@
+<#
+.SYNOPSIS
+    Installs the pinned WiX Toolset used by jpackage to build the MSI/EXE.
+
+.DESCRIPTION
+    Installs WiX as a global .NET tool (requires the .NET SDK 8 or newer) and adds the Util and UI
+    extensions that jpackage 25 needs. Re-running is safe. Open a new PowerShell window afterwards,
+    or keep using this one: %USERPROFILE%\.dotnet\tools is added to PATH for the current session.
+#>
+[CmdletBinding()]
+param([string]$Version = '5.0.2')
+$ErrorActionPreference = 'Stop'
+. (Join-Path $PSScriptRoot 'Common.ps1')
+
+if (-not (Get-Command 'dotnet.exe' -ErrorAction SilentlyContinue)) {
+    throw 'The .NET SDK is required to install WiX. Install the .NET 8 SDK from https://dotnet.microsoft.com/download, then run this script again.'
+}
+$installed = (Invoke-Captured 'dotnet.exe' @('tool', 'list', '--global')).Output | Where-Object { $_ -match '^\s*wix\s' }
+if ($installed) { Invoke-Checked 'dotnet.exe' @('tool', 'update', '--global', 'wix', '--version', $Version) "Update WiX to $Version" }
+else { Invoke-Checked 'dotnet.exe' @('tool', 'install', '--global', 'wix', '--version', $Version) "Install WiX $Version" }
+
+$tools = Join-Path $env:USERPROFILE '.dotnet\tools'
+if (($env:PATH -split ';') -notcontains $tools) { $env:PATH = "$tools;$env:PATH" }
+foreach ($extension in 'WixToolset.Util.wixext', 'WixToolset.UI.wixext') {
+    Invoke-Checked (Join-Path $tools 'wix.exe') @('extension', 'add', '--global', "$extension/$Version") "Add $extension $Version"
+}
+Write-Host "Ready: $(Get-WixToolset)" -ForegroundColor Green
diff --git a/packaging/windows/Invoke-ReleaseValidation.ps1 b/packaging/windows/Invoke-ReleaseValidation.ps1
new file mode 100644
index 0000000..f237edb
--- /dev/null
+++ b/packaging/windows/Invoke-ReleaseValidation.ps1
@@ -0,0 +1,164 @@
+<#
+.SYNOPSIS
+    One-command release validation: all automated tests, installer build, app smoke test, and an elevated
+    install / upgrade / downgrade-refusal / uninstall cycle. Results go to packaging\target\release-validation.
+
+.DESCRIPTION
+    Steps (each is recorded as PASS, FAIL or SKIPPED in summary.md and summary.json):
+      1. Toolchain: JDK 25 (JAVA_HOME, or the newest C:\Program Files\Eclipse Adoptium\jdk-25*),
+         WiX Toolset (installed with Install-WixToolset.ps1 when the .NET SDK is available).
+      2. Build-Installer.ps1: mvnw.cmd clean verify (every automated test), jlink, jpackage app image,
+         smoke test, MSI, checksums. Surefire results are summarised per module.
+      3. A second MSI with the next patch version, used only to test upgrading in place.
+      4. Test-Installer.ps1 in an elevated window (Windows asks for permission). It uses a temporary
+         LOCALAPPDATA, so your real application data is not touched, and it uninstalls at the end.
+    Use -SkipInstallerLifecycle to skip step 4.
+
+.EXAMPLE
+    powershell -NoProfile -ExecutionPolicy Bypass -File .\packaging\windows\Invoke-ReleaseValidation.ps1
+#>
+[CmdletBinding()]
+param(
+    [switch]$SkipInstallerLifecycle,
+    [switch]$Offline
+)
+$ErrorActionPreference = 'Stop'
+. (Join-Path $PSScriptRoot 'Common.ps1')
+
+Assert-WindowsX64
+$root = Get-RepositoryRoot
+$settings = Get-InstallerSettings $root
+# packaging\target is removed by "mvnw clean"; collect results in a temporary folder until the end.
+$staging = New-EmptyDirectory (Join-Path ([IO.Path]::GetTempPath()) ('api-testing-platform-validation-' + [guid]::NewGuid().ToString('N')))
+$steps = New-Object System.Collections.Generic.List[object]
+function Add-Step([string]$Name, [string]$State, [string]$Detail) {
+    $steps.Add([pscustomobject]@{ Step = $Name; Result = $State; Detail = $Detail })
+    $color = @{ PASS = 'Green'; FAIL = 'Red'; SKIPPED = 'Yellow' }[$State]
+    Write-Host ("[{0}] {1} - {2}" -f $State, $Name, $Detail) -ForegroundColor $color
+}
+function Invoke-LoggedScript([string]$Script, [string[]]$Arguments, [string]$Log) {
+    $previous = $ErrorActionPreference; $ErrorActionPreference = 'Continue'
+    try {
+        & powershell.exe -NoProfile -ExecutionPolicy Bypass -File $Script @Arguments 2>&1 | ForEach-Object { "$_" } | Tee-Object -FilePath $Log | Out-Host
+        return $LASTEXITCODE
+    } finally { $ErrorActionPreference = $previous }
+}
+
+# 1. Toolchain ---------------------------------------------------------------------------------------
+$javaHome = $env:JAVA_HOME
+$jdk = $null
+try { $jdk = Get-Jdk $javaHome } catch {
+    $candidate = Get-ChildItem -Path "$env:ProgramFiles\Eclipse Adoptium" -Directory -Filter 'jdk-25*' -ErrorAction SilentlyContinue |
+        Sort-Object Name -Descending | Select-Object -First 1
+    if ($null -eq $candidate) { throw "JDK 25 not found. $($_.Exception.Message)" }
+    $javaHome = $candidate.FullName
+    $jdk = Get-Jdk $javaHome
+}
+$env:JAVA_HOME = $jdk.Home
+Add-Step 'JDK' 'PASS' "$($jdk.Vendor) $($jdk.Version) at $($jdk.Home)"
+$wix = $null
+try { $wix = Get-WixToolset } catch {
+    if (Get-Command 'dotnet.exe' -ErrorAction SilentlyContinue) {
+        $code = Invoke-LoggedScript (Join-Path $PSScriptRoot 'Install-WixToolset.ps1') @() (Join-Path $staging 'wix-install.log')
+        if ($code -eq 0) { try { $wix = Get-WixToolset } catch { } }
+    }
+}
+if ($wix) { Add-Step 'WiX Toolset' 'PASS' $wix }
+else { Add-Step 'WiX Toolset' 'FAIL' 'Not available; only the app image can be built. Install the .NET 8 SDK, then run Install-WixToolset.ps1.' }
+
+# 2. Tests, app image, smoke test and installer --------------------------------------------------------
+$build = @('-JavaHome', $jdk.Home)
+if ($Offline) { $build += '-Offline' }
+if (-not $wix) { $build += '-AppImageOnly' }
+$code = Invoke-LoggedScript (Join-Path $PSScriptRoot 'Build-Installer.ps1') $build (Join-Path $staging 'build-installer.log')
+
+$modules = @()
+foreach ($report in Get-ChildItem -Path $root -Recurse -Filter 'TEST-*.xml' -ErrorAction SilentlyContinue | Where-Object { $_.FullName -match '\\target\\surefire-reports\\' }) {
+    [xml]$suite = Get-Content -LiteralPath $report.FullName -Raw
+    $module = ($report.FullName.Substring($root.Length + 1) -split '\\')[0]
+    $suiteNode = $suite.DocumentElement
+    $failed = @($suiteNode.SelectNodes('testcase') | Where-Object { $_.SelectSingleNode('failure|error') } | ForEach-Object {
+            $problem = $_.SelectSingleNode('failure|error')
+            $message = "$($problem.GetAttribute('message'))"
+            if ($message.Length -gt 300) { $message = $message.Substring(0, 300) }
+            "$($_.GetAttribute('classname')).$($_.GetAttribute('name')): $message" })
+    $modules += [pscustomobject]@{ Module = $module; Tests = [int]$suiteNode.GetAttribute('tests'); Failures = [int]$suiteNode.GetAttribute('failures')
+        Errors = [int]$suiteNode.GetAttribute('errors'); Skipped = [int]$suiteNode.GetAttribute('skipped'); FailedCases = $failed }
+}
+$byModule = @($modules | Group-Object Module | ForEach-Object {
+        [pscustomobject]@{ Module = $_.Name; Tests = ($_.Group | Measure-Object Tests -Sum).Sum; Failures = ($_.Group | Measure-Object Failures -Sum).Sum
+            Errors = ($_.Group | Measure-Object Errors -Sum).Sum; Skipped = ($_.Group | Measure-Object Skipped -Sum).Sum
+            FailedCases = @($_.Group | ForEach-Object { $_.FailedCases }) } })
+$total = ($byModule | Measure-Object Tests -Sum).Sum
+$broken = ($byModule | Measure-Object Failures -Sum).Sum + ($byModule | Measure-Object Errors -Sum).Sum
+$skipped = ($byModule | Measure-Object Skipped -Sum).Sum
+if ($total -gt 0 -and $broken -eq 0) { Add-Step 'Automated tests (mvnw clean verify)' 'PASS' "$total tests, $skipped skipped, 0 failures/errors" }
+else { Add-Step 'Automated tests (mvnw clean verify)' 'FAIL' "$total tests, $broken failures/errors, $skipped skipped" }
+
+$installerName = "$($settings.Name)-$(ConvertTo-InstallerVersion $settings.ProjectVersion).msi"
+$installer = Join-Path $root "dist\$installerName"
+if ($code -eq 0) {
+    if ($wix) { Add-Step 'Build, app smoke test and MSI' 'PASS' "dist\$installerName" }
+    else { Add-Step 'Build and app smoke test' 'PASS' 'App image only (no WiX)' }
+} else { Add-Step 'Build-Installer.ps1' 'FAIL' "exit code $code; see build-installer.log" }
+
+# 3. Next patch version for the upgrade test -----------------------------------------------------------
+$upgrade = $null
+if ($code -eq 0 -and $wix) {
+    $parts = (ConvertTo-InstallerVersion $settings.ProjectVersion) -split '\.'
+    $next = '{0}.{1}.{2}' -f $parts[0], $parts[1], ([int]$parts[2] + 1)
+    $upgradeFolder = Join-Path $staging 'upgrade-test'
+    $upgradeCode = Invoke-LoggedScript (Join-Path $PSScriptRoot 'Build-Installer.ps1') @('-JavaHome', $jdk.Home, '-SkipMavenBuild', '-SkipSmokeTest', '-AppVersion', $next, '-Destination', $upgradeFolder) (Join-Path $staging 'build-upgrade-test.log')
+    $upgrade = Join-Path $upgradeFolder "$($settings.Name)-$next.msi"
+    if ($upgradeCode -eq 0 -and (Test-Path -LiteralPath $upgrade)) { Add-Step 'Upgrade-test MSI' 'PASS' "$next (same code, higher version)" }
+    else { Add-Step 'Upgrade-test MSI' 'FAIL' "exit code $upgradeCode"; $upgrade = $null }
+}
+
+# 4. Elevated install / upgrade / uninstall --------------------------------------------------------------
+if ($SkipInstallerLifecycle) { Add-Step 'Installer lifecycle' 'SKIPPED' '-SkipInstallerLifecycle' }
+elseif (-not (Test-Path -LiteralPath $installer)) { Add-Step 'Installer lifecycle' 'SKIPPED' 'No MSI was built' }
+else {
+    $lifecycle = Join-Path $staging 'installer-validation'
+    $arguments = "-NoProfile -ExecutionPolicy Bypass -File `"$(Join-Path $PSScriptRoot 'Test-Installer.ps1')`" -Msi `"$installer`" -LogDirectory `"$lifecycle`""
+    if ($upgrade) { $arguments += " -UpgradeMsi `"$upgrade`"" }
+    try {
+        Write-Host 'Windows will ask for administrator permission to install and uninstall the MSI.' -ForegroundColor Yellow
+        $process = Start-Process -FilePath 'powershell.exe' -ArgumentList $arguments -Verb RunAs -Wait -PassThru
+        $report = Join-Path $lifecycle 'installer-validation.md'
+        $passedChecks = 0; $allChecks = 0
+        if (Test-Path -LiteralPath (Join-Path $lifecycle 'installer-validation.json')) {
+            $json = Get-Content -LiteralPath (Join-Path $lifecycle 'installer-validation.json') -Raw | ConvertFrom-Json
+            $allChecks = @($json.checks).Count; $passedChecks = @($json.checks | Where-Object { $_.Passed }).Count
+        }
+        if ($process.ExitCode -eq 0 -and $allChecks -gt 0) { Add-Step 'Installer lifecycle' 'PASS' "$passedChecks/$allChecks checks; see installer-validation\installer-validation.md" }
+        else { Add-Step 'Installer lifecycle' 'FAIL' "exit code $($process.ExitCode); $passedChecks/$allChecks checks passed" }
+    } catch { Add-Step 'Installer lifecycle' 'SKIPPED' "Not run: $($_.Exception.Message)" }
+}
+
+# Summary ----------------------------------------------------------------------------------------------
+$summary = [ordered]@{
+    testedAtUtc = (Get-Date).ToUniversalTime().ToString('yyyy-MM-ddTHH:mm:ssZ')
+    windows     = [Environment]::OSVersion.VersionString
+    computer    = "$((Get-CimInstance Win32_Processor | Select-Object -First 1).Name), $([math]::Round((Get-CimInstance Win32_ComputerSystem).TotalPhysicalMemory / 1GB)) GB RAM"
+    steps       = $steps
+    tests       = $byModule
+}
+$summary | ConvertTo-Json -Depth 5 | Set-Content -LiteralPath (Join-Path $staging 'summary.json') -Encoding UTF8
+$markdown = @('| Step | Result | Detail |', '| --- | --- | --- |') + @($steps | ForEach-Object { '| {0} | {1} | {2} |' -f $_.Step, $_.Result, ($_.Detail -replace '\|', '/') })
+$markdown += @('', '| Module | Tests | Failures | Errors | Skipped |', '| --- | ---: | ---: | ---: | ---: |')
+$markdown += @($byModule | ForEach-Object { '| {0} | {1} | {2} | {3} | {4} |' -f $_.Module, $_.Tests, $_.Failures, $_.Errors, $_.Skipped })
+$failedCases = @($byModule | ForEach-Object { $_.FailedCases } | Where-Object { $_ })
+if ($failedCases.Count -gt 0) { $markdown += @('', 'Failed tests:', '') + @($failedCases | ForEach-Object { "- $_" }) }
+$markdown | Set-Content -LiteralPath (Join-Path $staging 'summary.md') -Encoding UTF8
+
+$results = New-EmptyDirectory (Join-Path $root 'packaging\target\release-validation')
+Copy-Item -Path (Join-Path $staging '*') -Destination $results -Recurse -Force
+foreach ($extra in 'dist\SHA256SUMS.txt', "dist\$($settings.Name)-$(ConvertTo-InstallerVersion $settings.ProjectVersion).build-info.json") {
+    if (Test-Path -LiteralPath (Join-Path $root $extra)) { Copy-Item -LiteralPath (Join-Path $root $extra) -Destination $results }
+}
+Remove-Item -LiteralPath (Join-Path $results 'upgrade-test') -Recurse -Force -ErrorAction SilentlyContinue
+Remove-Item -LiteralPath $staging -Recurse -Force -ErrorAction SilentlyContinue
+Write-Host ''
+$markdown | ForEach-Object { Write-Host $_ }
+Write-Host "`nResults: $results" -ForegroundColor Cyan
+if (@($steps | Where-Object { $_.Result -eq 'FAIL' }).Count -gt 0) { exit 1 }
diff --git a/packaging/windows/Start-SandboxValidation.ps1 b/packaging/windows/Start-SandboxValidation.ps1
new file mode 100644
index 0000000..f7f8900
--- /dev/null
+++ b/packaging/windows/Start-SandboxValidation.ps1
@@ -0,0 +1,45 @@
+<#
+.SYNOPSIS
+    Runs Test-Installer.ps1 inside a fresh Windows Sandbox: a clean, disposable Windows with no Java.
+
+.DESCRIPTION
+    Requires Windows 10/11 Pro, Enterprise or Education with the "Windows Sandbox" feature enabled and
+    hardware virtualization turned on in the BIOS/UEFI. The repository is mapped read-only; results are
+    written to packaging\target\sandbox-validation on the host. Close the sandbox when the PowerShell
+    window inside it reports the result; everything inside the sandbox is discarded.
+#>
+[CmdletBinding()]
+param(
+    [Parameter(Mandatory = $true)][string]$Msi,
+    [string]$UpgradeMsi
+)
+$ErrorActionPreference = 'Stop'
+. (Join-Path $PSScriptRoot 'Common.ps1')
+
+$root = Get-RepositoryRoot
+$sandbox = Join-Path $env:WINDIR 'System32\WindowsSandbox.exe'
+if (-not (Test-Path -LiteralPath $sandbox)) { throw 'Windows Sandbox is not enabled. Enable it in "Turn Windows features on or off", or validate on a clean VM.' }
+$results = (New-Item -ItemType Directory -Path (Join-Path $root 'packaging\target\sandbox-validation') -Force).FullName
+
+function Get-SandboxPath([string]$Path) {
+    $full = (Resolve-Path -LiteralPath $Path).Path
+    if (-not $full.StartsWith($root, [StringComparison]::OrdinalIgnoreCase)) { throw "$Path must be inside the repository (for example dist\)." }
+    return 'C:\Validation\repo' + $full.Substring($root.Length)
+}
+$arguments = "-Msi `"$(Get-SandboxPath $Msi)`""
+if ($UpgradeMsi) { $arguments += " -UpgradeMsi `"$(Get-SandboxPath $UpgradeMsi)`"" }
+$command = "powershell.exe -NoExit -NoProfile -ExecutionPolicy Bypass -File C:\Validation\repo\packaging\windows\Test-Installer.ps1 $arguments -LogDirectory C:\Validation\results"
+
+$configuration = Join-Path $results 'installer-validation.wsb'
+@"
+<Configuration>
+  <Networking>Disable</Networking>
+  <MappedFolders>
+    <MappedFolder><HostFolder>$([Security.SecurityElement]::Escape($root))</HostFolder><SandboxFolder>C:\Validation\repo</SandboxFolder><ReadOnly>true</ReadOnly></MappedFolder>
+    <MappedFolder><HostFolder>$([Security.SecurityElement]::Escape($results))</HostFolder><SandboxFolder>C:\Validation\results</SandboxFolder><ReadOnly>false</ReadOnly></MappedFolder>
+  </MappedFolders>
+  <LogonCommand><Command>$([Security.SecurityElement]::Escape($command))</Command></LogonCommand>
+</Configuration>
+"@ | Set-Content -LiteralPath $configuration -Encoding UTF8
+Start-Process -FilePath $configuration
+Write-Host "Windows Sandbox started. Results will appear in $results"
diff --git a/packaging/windows/Test-AppImage.ps1 b/packaging/windows/Test-AppImage.ps1
new file mode 100644
index 0000000..66428ac
--- /dev/null
+++ b/packaging/windows/Test-AppImage.ps1
@@ -0,0 +1,114 @@
+<#
+.SYNOPSIS
+    Starts a packaged or installed API Testing Platform launcher once and checks where it writes.
+
+.DESCRIPTION
+    The launcher runs with a temporary LOCALAPPDATA, without JAVA_HOME and with Java removed from PATH,
+    so it must use its bundled runtime. The built-in startup probe (platform.startup.measurement) records
+    when the window is ready and closes the application normally. The check fails unless:
+      - the process exits with code 0 after the window was ready;
+      - the database, logs and the versioned native cache are created below LOCALAPPDATA;
+      - nothing in the installation directory is created or changed.
+    Returns a summary object. Your real data in %LOCALAPPDATA%\API Testing Platform is never used.
+#>
+[CmdletBinding()]
+param(
+    [Parameter(Mandatory = $true)][string]$Launcher,
+    [string]$ExpectedVersion,
+    # Use (and keep) this LOCALAPPDATA instead of a temporary one, e.g. to test data across upgrades.
+    [string]$LocalAppData,
+    [int]$TimeoutSeconds = 90
+)
+$ErrorActionPreference = 'Stop'
+. (Join-Path $PSScriptRoot 'Common.ps1')
+
+$Launcher = (Resolve-Path -LiteralPath $Launcher).Path
+$installation = Split-Path -Parent $Launcher
+$work = New-EmptyDirectory (Join-Path ([IO.Path]::GetTempPath()) ('api-testing-platform-smoke-' + [guid]::NewGuid().ToString('N')))
+$temporaryData = [string]::IsNullOrWhiteSpace($LocalAppData)
+if ($temporaryData) { $LocalAppData = Join-Path $work 'LocalAppData' }
+New-Item -ItemType Directory -Path $LocalAppData -Force | Out-Null
+$LocalAppData = (Resolve-Path -LiteralPath $LocalAppData).Path
+$data = Join-Path $LocalAppData 'API Testing Platform'
+$measurement = Join-Path $work 'startup.properties'
+
+function Get-Snapshot([string]$Folder) {
+    return @(Get-ChildItem -LiteralPath $Folder -Recurse -Force -File | ForEach-Object {
+            '{0}|{1}|{2}' -f $_.FullName.Substring($Folder.Length), $_.Length, $_.LastWriteTimeUtc.Ticks
+        } | Sort-Object)
+}
+$before = Get-Snapshot $installation
+
+$saved = @{ LOCALAPPDATA = $env:LOCALAPPDATA; JAVA_TOOL_OPTIONS = $env:JAVA_TOOL_OPTIONS; JAVA_HOME = $env:JAVA_HOME; PATH = $env:PATH }
+$process = $null
+$timer = [Diagnostics.Stopwatch]::StartNew()
+try {
+    $env:LOCALAPPDATA = $LocalAppData
+    $env:JAVA_TOOL_OPTIONS = '"-Dplatform.startup.measurement=' + $measurement.Replace('\', '/') + '" -Dplatform.startup.autoExit=true'
+    Remove-Item Env:\JAVA_HOME -ErrorAction SilentlyContinue
+    $env:PATH = (($env:PATH -split ';') | Where-Object { $_ -and $_ -notmatch '(?i)(java|jdk|jre|adoptium|zulu|corretto)' }) -join ';'
+    $process = Start-Process -FilePath $Launcher -PassThru -WorkingDirectory $work `
+        -RedirectStandardOutput (Join-Path $work 'stdout.log') -RedirectStandardError (Join-Path $work 'stderr.log')
+    $null = $process.Handle   # caches the handle so ExitCode is available after the process ends
+    while (-not (Test-Path -LiteralPath $measurement) -and -not $process.HasExited -and $timer.Elapsed.TotalSeconds -lt $TimeoutSeconds) {
+        Start-Sleep -Milliseconds 200
+    }
+    $readyMs = $timer.ElapsedMilliseconds
+    if (-not $process.WaitForExit(30000)) {
+        Stop-Process -Id $process.Id -Force
+        throw 'The application did not close within 30 seconds after the startup probe.'
+    }
+    $exitCode = $process.ExitCode
+} finally {
+    foreach ($name in $saved.Keys) {
+        if ($null -eq $saved[$name]) { Remove-Item "Env:\$name" -ErrorAction SilentlyContinue }
+        else { Set-Item "Env:\$name" $saved[$name] }
+    }
+}
+
+$failures = New-Object System.Collections.Generic.List[string]
+if (-not (Test-Path -LiteralPath $measurement)) { $failures.Add("The window did not become ready within $TimeoutSeconds seconds.") }
+if ($exitCode -ne 0) { $failures.Add("The application exited with code $exitCode.") }
+if (-not (Test-Path -LiteralPath (Join-Path $data 'platform.sqlite'))) { $failures.Add("No database was created in $data.") }
+if (-not (Get-ChildItem -LiteralPath (Join-Path $data 'logs') -File -ErrorAction SilentlyContinue)) { $failures.Add('No structured log was written below LOCALAPPDATA.') }
+$cacheVersion = $ExpectedVersion
+if ([string]::IsNullOrWhiteSpace($cacheVersion)) { $cacheVersion = '*' }
+$javafxCache = @(Get-ChildItem -Path (Join-Path $data "cache\$cacheVersion\openjfx") -Recurse -File -Filter '*.dll' -ErrorAction SilentlyContinue)
+if ($javafxCache.Count -eq 0) { $failures.Add("JavaFX native libraries were not cached below $data\cache\$cacheVersion.") }
+$after = Get-Snapshot $installation
+$changed = @(Compare-Object $before $after | ForEach-Object { ($_.InputObject -split '\|')[0] })
+if ($changed.Count -gt 0) { $failures.Add("Files changed in the installation directory: $($changed -join ', ')") }
+$runtimeRelease = Join-Path $installation 'runtime\release'
+$bundledJava = ''
+if (Test-Path -LiteralPath $runtimeRelease) {
+    $bundledJava = ((Get-Content -LiteralPath $runtimeRelease | Where-Object { $_ -match '^JAVA_VERSION=' }) -replace '^JAVA_VERSION="?|"$', '')
+}
+if ($bundledJava -notmatch '^25(\.|$)') { $failures.Add("The bundled runtime does not report Java 25 ($runtimeRelease).") }
+
+$probe = @{}
+if (Test-Path -LiteralPath $measurement) {
+    Get-Content -LiteralPath $measurement | Where-Object { $_ -match '^[a-zA-Z]+=' } | ForEach-Object {
+        $pair = $_ -split '=', 2; $probe[$pair[0]] = $pair[1]
+    }
+}
+$result = [ordered]@{
+    launcher            = $Launcher
+    passed              = ($failures.Count -eq 0)
+    exitCode            = $exitCode
+    launchToReadyMs     = $readyMs
+    jvmToReadyMs        = $probe['jvmToReadyMs']
+    usedHeapMiB         = $probe['usedHeapMiB']
+    bundledJava         = $bundledJava
+    javafxCachedLibrary = ($javafxCache | Select-Object -First 1 | ForEach-Object { $_.FullName.Substring($LocalAppData.Length) })
+    failures            = @($failures)
+}
+if ($failures.Count -gt 0) {
+    $stderr = Join-Path $work 'stderr.log'
+    $tail = ''
+    if (Test-Path -LiteralPath $stderr) { $tail = (Get-Content -LiteralPath $stderr -Tail 40) -join "`n" }
+    throw ("Smoke test failed for $Launcher`n - " + ($failures -join "`n - ") + "`nLauncher stderr (last lines):`n$tail`nWork folder kept: $work")
+}
+Write-Host "Smoke test passed: ready after $readyMs ms, Java $bundledJava, data and caches below LOCALAPPDATA only." -ForegroundColor Green
+# A caller-supplied LOCALAPPDATA lives outside the work folder and is kept.
+Remove-Item -LiteralPath $work -Recurse -Force -ErrorAction SilentlyContinue
+return [pscustomobject]$result
diff --git a/packaging/windows/Test-Installer.ps1 b/packaging/windows/Test-Installer.ps1
new file mode 100644
index 0000000..042cdc8
--- /dev/null
+++ b/packaging/windows/Test-Installer.ps1
@@ -0,0 +1,172 @@
+<#
+.SYNOPSIS
+    Validates install, upgrade, downgrade protection and uninstall of the MSI on a clean Windows machine.
+
+.DESCRIPTION
+    Run elevated on a clean Windows 10/11 x64 machine, VM or Windows Sandbox where API Testing Platform
+    is not installed (see Start-SandboxValidation.ps1). Uses a dedicated temporary LOCALAPPDATA for the
+    application data, so an existing user's data is never touched. Steps:
+      1. Silent install of -Msi; checks registration, upgrade code, files, shortcuts and bundled Java.
+      2. Launches the installed app without any Java on PATH (Test-AppImage.ps1) and adds a data marker.
+      3. Optional: installs -UpgradeMsi over it; checks one registration, new version, data preserved,
+         launches again; then verifies the older MSI is refused (no downgrade).
+      4. Silent uninstall; checks program files and shortcuts are removed and the user data is preserved.
+    Writes installer-validation.json and installer-validation.md plus verbose msiexec logs to -LogDirectory.
+    Exit code 0 only when every check passes.
+
+.EXAMPLE
+    .\packaging\windows\Test-Installer.ps1 -Msi "dist\API Testing Platform-0.1.0.msi" -UpgradeMsi "dist\API Testing Platform-0.1.1.msi"
+#>
+[CmdletBinding()]
+param(
+    [Parameter(Mandatory = $true)][string]$Msi,
+    [string]$UpgradeMsi,
+    [string]$LogDirectory,
+    [switch]$KeepInstalled
+)
+$ErrorActionPreference = 'Stop'
+. (Join-Path $PSScriptRoot 'Common.ps1')
+
+Assert-WindowsX64
+$principal = New-Object Security.Principal.WindowsPrincipal([Security.Principal.WindowsIdentity]::GetCurrent())
+if (-not $principal.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) {
+    throw 'Run this validation from an elevated PowerShell: the MSI installs per machine into Program Files.'
+}
+$settings = Get-InstallerSettings (Get-RepositoryRoot)
+$Msi = (Resolve-Path -LiteralPath $Msi).Path
+if ($UpgradeMsi) { $UpgradeMsi = (Resolve-Path -LiteralPath $UpgradeMsi).Path }
+if ([string]::IsNullOrWhiteSpace($LogDirectory)) { $LogDirectory = Join-Path (Get-RepositoryRoot) 'packaging\target\installer-validation' }
+$LogDirectory = (New-Item -ItemType Directory -Path $LogDirectory -Force).FullName
+$localAppData = New-EmptyDirectory (Join-Path ([IO.Path]::GetTempPath()) ('api-testing-platform-installer-' + [guid]::NewGuid().ToString('N')))
+$data = Join-Path $localAppData 'API Testing Platform'
+$installDirectory = Join-Path $env:ProgramFiles $settings.Name
+$launcher = Join-Path $installDirectory "$($settings.Name).exe"
+$checks = New-Object System.Collections.Generic.List[object]
+
+function Add-Check([string]$Name, [bool]$Passed, [string]$Detail) {
+    $checks.Add([pscustomobject]@{ Check = $Name; Passed = $Passed; Detail = $Detail })
+    $color = 'Red'; $label = 'FAIL'
+    if ($Passed) { $color = 'Green'; $label = 'PASS' }
+    Write-Host ("[{0}] {1} - {2}" -f $label, $Name, $Detail) -ForegroundColor $color
+}
+
+function Get-MsiProperty([string]$Path, [string]$Property) {
+    $installer = New-Object -ComObject WindowsInstaller.Installer
+    $database = $installer.GetType().InvokeMember('OpenDatabase', 'InvokeMethod', $null, $installer, @($Path, 0))
+    $view = $database.GetType().InvokeMember('OpenView', 'InvokeMethod', $null, $database, @("SELECT Value FROM Property WHERE Property = '$Property'"))
+    $view.GetType().InvokeMember('Execute', 'InvokeMethod', $null, $view, $null) | Out-Null
+    $record = $view.GetType().InvokeMember('Fetch', 'InvokeMethod', $null, $view, $null)
+    $value = $null
+    if ($null -ne $record) { $value = $record.GetType().InvokeMember('StringData', 'GetProperty', $null, $record, 1) }
+    $view.GetType().InvokeMember('Close', 'InvokeMethod', $null, $view, $null) | Out-Null
+    [void][Runtime.InteropServices.Marshal]::FinalReleaseComObject($view)
+    [void][Runtime.InteropServices.Marshal]::FinalReleaseComObject($database)
+    [void][Runtime.InteropServices.Marshal]::FinalReleaseComObject($installer)
+    return $value
+}
+
+function Get-Registrations {
+    $keys = 'HKLM:\Software\Microsoft\Windows\CurrentVersion\Uninstall\*', 'HKLM:\Software\WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall\*',
+    'HKCU:\Software\Microsoft\Windows\CurrentVersion\Uninstall\*'
+    return @(Get-ItemProperty -Path $keys -ErrorAction SilentlyContinue | Where-Object {
+            $_.PSObject.Properties['DisplayName'] -and $_.DisplayName -eq $settings.Name })
+}
+
+function Invoke-Msiexec([string[]]$Arguments, [string]$Log) {
+    $quoted = @($Arguments | ForEach-Object { if ($_ -match '\s') { '"' + $_ + '"' } else { $_ } })
+    $quoted += @('/qn', '/norestart', '/l*v', ('"' + $Log + '"'))
+    $process = Start-Process -FilePath 'msiexec.exe' -ArgumentList ($quoted -join ' ') -Wait -PassThru
+    return $process.ExitCode
+}
+
+function Get-Shortcuts {
+    $menus = @((Join-Path $env:ProgramData "Microsoft\Windows\Start Menu\Programs\$($settings.Name)"),
+        (Join-Path $env:APPDATA "Microsoft\Windows\Start Menu\Programs\$($settings.Name)"))
+    return @($menus | Where-Object { Test-Path -LiteralPath $_ } | ForEach-Object { Get-ChildItem -LiteralPath $_ -Filter '*.lnk' } | ForEach-Object { $_.BaseName } | Sort-Object)
+}
+
+function Test-InstalledVersion([string]$Label, [string]$Version) {
+    $registrations = Get-Registrations
+    Add-Check "$Label registration" ($registrations.Count -eq 1) "$($registrations.Count) Apps & Features entry/entries"
+    if ($registrations.Count -ge 1) {
+        Add-Check "$Label version" ($registrations[0].DisplayVersion -eq $Version) "registered $($registrations[0].DisplayVersion), expected $Version"
+    }
+    Add-Check "$Label launcher" (Test-Path -LiteralPath $launcher) $launcher
+    Add-Check "$Label data-removal launcher" (Test-Path -LiteralPath (Join-Path $installDirectory "$($settings.RemoveLauncher).exe")) 'explicit user-data removal is available'
+    $mods = @(Get-ChildItem -LiteralPath (Join-Path $installDirectory 'app\mods') -Filter '*.jar' -ErrorAction SilentlyContinue)
+    Add-Check "$Label module path" ($mods.Count -gt 10) "$($mods.Count) jars in app\mods"
+    $shortcuts = Get-Shortcuts
+    Add-Check "$Label Start menu" (($shortcuts -contains $settings.Name) -and ($shortcuts -contains $settings.RemoveLauncher)) ("shortcuts: " + ($shortcuts -join ', '))
+    Add-Check "$Label data outside install directory" (-not (Test-Path -LiteralPath (Join-Path $installDirectory 'platform.sqlite'))) 'no database in Program Files'
+}
+
+function Invoke-Smoke([string]$Label, [string]$Version) {
+    try {
+        $smoke = & (Join-Path $PSScriptRoot 'Test-AppImage.ps1') -Launcher $launcher -ExpectedVersion $Version -LocalAppData $localAppData
+        Add-Check "$Label launch without system Java" $true ("ready after {0} ms, bundled Java {1}" -f $smoke.launchToReadyMs, $smoke.bundledJava)
+    } catch { Add-Check "$Label launch without system Java" $false $_.Exception.Message }
+}
+
+$version = Get-MsiProperty $Msi 'ProductVersion'
+$upgradeCode = Get-MsiProperty $Msi 'UpgradeCode'
+Add-Check 'Upgrade code' ($upgradeCode.Trim('{}') -eq $settings.UpgradeUuid) "$upgradeCode"
+$existing = Get-Registrations
+if ($existing.Count -gt 0) { throw "$($settings.Name) is already installed ($($existing[0].DisplayVersion)). Use a clean machine, VM or Windows Sandbox." }
+
+# 1-2. Install and launch.
+$code = Invoke-Msiexec @('/i', $Msi) (Join-Path $LogDirectory '1-install.log')
+Add-Check 'Install' ($code -in 0, 3010) "msiexec exit code $code"
+Test-InstalledVersion 'Install' $version
+Invoke-Smoke 'Install' $version
+$marker = Join-Path $data 'installer-validation-marker.txt'
+$token = [guid]::NewGuid().ToString()
+if (Test-Path -LiteralPath $data) { Set-Content -LiteralPath $marker -Value $token -Encoding ASCII }
+$database = Join-Path $data 'platform.sqlite'
+$created = $null
+if (Test-Path -LiteralPath $database) { $created = (Get-Item -LiteralPath $database).CreationTimeUtc }
+
+# 3. Upgrade in place and refuse downgrade.
+if ($UpgradeMsi) {
+    $newVersion = Get-MsiProperty $UpgradeMsi 'ProductVersion'
+    $code = Invoke-Msiexec @('/i', $UpgradeMsi) (Join-Path $LogDirectory '2-upgrade.log')
+    Add-Check 'Upgrade' ($code -in 0, 3010) "msiexec exit code $code ($version -> $newVersion)"
+    Test-InstalledVersion 'Upgrade' $newVersion
+    $kept = (Test-Path -LiteralPath $marker) -and ((Get-Content -LiteralPath $marker -Raw).Trim() -eq $token)
+    $sameDatabase = ($null -ne $created) -and (Test-Path -LiteralPath $database) -and ((Get-Item -LiteralPath $database).CreationTimeUtc -eq $created)
+    Add-Check 'Upgrade keeps user data' ($kept -and $sameDatabase) 'marker and original database file still present'
+    Invoke-Smoke 'Upgrade' $newVersion
+    Add-Check 'Upgrade clears old native cache' (-not (Test-Path -LiteralPath (Join-Path $data "cache\$version"))) "cache\$version removed at next start"
+    $code = Invoke-Msiexec @('/i', $Msi) (Join-Path $LogDirectory '3-downgrade.log')
+    $registrations = Get-Registrations
+    $stillNew = ($registrations.Count -eq 1) -and ($registrations[0].DisplayVersion -eq $newVersion)
+    Add-Check 'Downgrade refused' (($code -ne 0) -and $stillNew) "msiexec exit code $code, installed version stays $newVersion"
+}
+
+# 4. Uninstall, keeping user data.
+if (-not $KeepInstalled) {
+    $registrations = Get-Registrations
+    if ($registrations.Count -ge 1) {
+        $code = Invoke-Msiexec @('/x', $registrations[0].PSChildName) (Join-Path $LogDirectory '4-uninstall.log')
+        Add-Check 'Uninstall' ($code -in 0, 3010) "msiexec exit code $code"
+    }
+    Add-Check 'Uninstall registration removed' ((Get-Registrations).Count -eq 0) 'no Apps & Features entry'
+    Add-Check 'Uninstall removes program files' (-not (Test-Path -LiteralPath $launcher)) $installDirectory
+    Add-Check 'Uninstall removes shortcuts' ((Get-Shortcuts).Count -eq 0) 'Start menu folder empty or removed'
+    $kept = (Test-Path -LiteralPath $marker) -and (Test-Path -LiteralPath $database)
+    Add-Check 'Uninstall preserves user data' $kept $data
+}
+
+$failed = @($checks | Where-Object { -not $_.Passed })
+$report = [ordered]@{
+    application = $settings.Name; installer = (Split-Path -Leaf $Msi); upgradeInstaller = $UpgradeMsi
+    windows = [Environment]::OSVersion.VersionString; testedAtUtc = (Get-Date).ToUniversalTime().ToString('yyyy-MM-ddTHH:mm:ssZ')
+    passed = ($failed.Count -eq 0); checks = $checks
+}
+$report | ConvertTo-Json -Depth 4 | Set-Content -LiteralPath (Join-Path $LogDirectory 'installer-validation.json') -Encoding UTF8
+$markdown = @('| Check | Result | Detail |', '| --- | --- | --- |') + @($checks | ForEach-Object {
+        $state = 'FAIL'; if ($_.Passed) { $state = 'PASS' }
+        '| {0} | {1} | {2} |' -f $_.Check, $state, ($_.Detail -replace '\|', '/') })
+$markdown | Set-Content -LiteralPath (Join-Path $LogDirectory 'installer-validation.md') -Encoding UTF8
+Remove-Item -LiteralPath $localAppData -Recurse -Force -ErrorAction SilentlyContinue
+Write-Host ("{0} of {1} checks passed. Logs: {2}" -f ($checks.Count - $failed.Count), $checks.Count, $LogDirectory)
+if ($failed.Count -gt 0) { exit 1 }
