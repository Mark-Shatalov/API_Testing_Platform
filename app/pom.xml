<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>dev.apitestingplatform</groupId>
        <artifactId>api-testing-platform</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>app</artifactId>
    <name>API Testing Platform - App</name>

    <dependencies>
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>mockwebserver</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>dev.apitestingplatform</groupId>
            <artifactId>ui</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.apitestingplatform</groupId>
            <artifactId>http-client</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.apitestingplatform</groupId>
            <artifactId>persistence-sqlite</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.apitestingplatform</groupId>
            <artifactId>security-windows</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.apitestingplatform</groupId>
            <artifactId>import-export</artifactId>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>--enable-native-access=javafx.graphics,org.xerial.sqlitejdbc,com.sun.jna --add-reads dev.apitestingplatform.app=org.fxmisc.richtext</argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <configuration>
                    <mainClass>dev.apitestingplatform.app/dev.apitestingplatform.app.ApiTestingPlatformApplication</mainClass>
                    <options>
                        <option>--enable-native-access=javafx.graphics,org.xerial.sqlitejdbc,com.sun.jna</option>
                    </options>
                    <launcher>api-testing-platform</launcher>
                    <jlinkImageName>api-testing-platform-runtime</jlinkImageName>
                    <stripDebug>true</stripDebug>
                    <noHeaderFiles>true</noHeaderFiles>
                    <noManPages>true</noManPages>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>

